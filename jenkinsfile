pipeline {
    agent any
    tools {
        jdk 'JDK21'
    }
    stages {
        stage('Checkout code')
        {
            steps {
                git branch: 'master', url: 'https://github.com/ssalmarezgui/TP-GIT.git'
            }
        }
        stage('Compile code')
        {
            steps {
                sh 'cd src && javac Application/Test.java'
            }
        }
        stage('Execute code')
        {
            steps {
                sh 'cd src && java Application.Test'
            }
        }
        stage('test message')
        {
            steps {
                echo 'Hello from github yesss'
            }
        }
    }
}
